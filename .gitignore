# ------------------------------------------------------------------------------
uploads/
**/uploads/
temp_exports/
**/temp_exports/
scratch/
**/scratch/
tmp/
temp/
*.tmp
*.temp

# ------------------------------------------------------------------------------
# 7. IDE, Editor, & Tool Caches
# ------------------------------------------------------------------------------
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.idea/
*.sublime-project
*.sublime-workspace
*.suo
*.ntvs*
*.njsproj
*.sln
*.swp
*.swo
*~


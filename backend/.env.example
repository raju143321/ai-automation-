# ResearchSphere AI - Backend Environment Configuration

# Application
NODE_ENV=development
APP_NAME=ResearchSphere AI
CLIENT_URL=http://localhost:5173
SERVER_URL=http://localhost:3000
API_PREFIX=/api/v1
PORT=3000

# Supabase (Optional: if unset, local persistent fallback store is used)
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Google Gemini API - Server only (Optional: if unset, offline grounded synthesis engine is used)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Optional embeddings
EMBEDDING_PROVIDER=
EMBEDDING_API_KEY=
EMBEDDING_MODEL=text-embedding-004
EMBEDDING_DIMENSIONS=768

# External research search (OpenAlex and Crossref have public open access defaults)
SEARCH_PROVIDER=openalex
SEARCH_API_KEY=
SEARCH_API_BASE_URL=

# Scholarly metadata integrations
CROSSREF_MAILTO=researcher@researchsphere.ai
OPENALEX_API_KEY=
PUBMED_API_KEY=

# Document processing limits
MAX_UPLOAD_BYTES=20971520
MAX_DOCUMENT_PAGES=1000
MAX_EXTRACTED_CHARACTERS=5000000
DOCUMENT_PROCESSING_TIMEOUT_MS=120000

# AI limits
AI_REQUEST_TIMEOUT_MS=60000
AI_MAX_RETRIES=2
AI_MAX_CONCURRENT_REQUESTS=5
AI_DAILY_REQUEST_LIMIT=100
AI_MAX_CONTEXT_CHUNKS=20

# Rate limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=60

# Observability
LOG_LEVEL=info
